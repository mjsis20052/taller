// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Fase 1 — MVP operativo (Cliente..Config) + Fase 3 (Repuesto,
// MovimientoStock, Gasto, Cobro) + Fase 4 (SolicitudFacturacion).
// Fase 5 (IA, WhatsApp Business API, API real del estudio) NO se
// implementa: el PRD pide solo diseñar puntos de enganche.
// ---------------------------------------------------------------------------

enum TipoPersona {
  FISICA
  JURIDICA
}

enum CondicionFiscal {
  CONSUMIDOR_FINAL
  RESPONSABLE_INSCRIPTO
  MONOTRIBUTISTA
  EXENTO
}

enum EstadoTurno {
  AGENDADO
  CANCELADO
  CONVERTIDO_OT
}

enum EstadoOT {
  TURNO_AGENDADO
  INGRESADO
  EN_DIAGNOSTICO
  PRESUPUESTADO
  APROBADO
  EN_EJECUCION
  TERMINADO
  FACTURADO
  ENTREGADO
  CANCELADA
}

enum NivelCombustible {
  VACIO
  UN_CUARTO
  MEDIO
  TRES_CUARTOS
  LLENO
}

enum TipoOTItem {
  REPUESTO
  MANO_OBRA
}

enum EntidadFoto {
  OT
  GASTO
  VEHICULO
}

enum EstadoPresupuesto {
  ENVIADO
  APROBADO
  RECHAZADO
  SIN_RESPUESTA
}

enum TipoMovimientoStock {
  ENTRADA
  SALIDA
  AJUSTE
}

enum CategoriaGasto {
  REPUESTOS
  HERRAMIENTAS
  ALQUILER
  SERVICIOS
  OTROS
}

enum EstadoSolicitudFacturacion {
  PENDIENTE
  ENVIADA
  FACTURADA
  ERROR
}

model Cliente {
  id              String          @id @default(cuid())
  nombre          String
  tipoPersona     TipoPersona
  dni             String?
  cuit            String?
  condicionFiscal CondicionFiscal @default(CONSUMIDOR_FINAL)
  telefono        String
  email           String?
  domicilio       String?
  notas           String?
  activo          Boolean         @default(true)
  // Enlace secreto para compartir con el cliente todo su historial (/informe/cliente/<token>).
  tokenInforme    String          @unique @default(dbgenerated("replace((gen_random_uuid())::text, '-'::text, ''::text)"))
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  vehiculos      Vehiculo[]
  turnos         Turno[]
  ordenesTrabajo OrdenTrabajo[]
  cobros         Cobro[]

  @@index([nombre])
  @@index([telefono])
}

model Vehiculo {
  id        String   @id @default(cuid())
  clienteId String
  patente   String   @unique
  marca     String
  modelo    String
  anio      Int?
  color     String?
  vin       String?
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cliente        Cliente               @relation(fields: [clienteId], references: [id])
  kilometrajes   KilometrajeRegistro[]
  turnos         Turno[]
  ordenesTrabajo OrdenTrabajo[]
  fotos          Foto[]

  @@index([clienteId])
}

model KilometrajeRegistro {
  id         String   @id @default(cuid())
  vehiculoId String
  km         Int
  fecha      DateTime @default(now())
  otId       String?

  vehiculo Vehiculo      @relation(fields: [vehiculoId], references: [id])
  ot       OrdenTrabajo? @relation(fields: [otId], references: [id])

  @@index([vehiculoId])
  @@index([otId])
}

model ServicioFrecuente {
  id             String   @id @default(cuid())
  nombre         String   @unique
  duracionMin    Int
  precioSugerido Decimal? @db.Decimal(12, 2)
  activo         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Turno {
  id          String      @id @default(cuid())
  clienteId   String
  vehiculoId  String
  fechaHora   DateTime
  duracionMin Int
  motivo      String
  estado      EstadoTurno @default(AGENDADO)
  otId        String?     @unique
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  cliente  Cliente       @relation(fields: [clienteId], references: [id])
  vehiculo Vehiculo      @relation(fields: [vehiculoId], references: [id])
  ot       OrdenTrabajo? @relation(fields: [otId], references: [id])

  @@index([clienteId])
  @@index([vehiculoId])
  @@index([fechaHora])
}

model OrdenTrabajo {
  id                  String            @id @default(cuid())
  numero              String            @unique
  clienteId           String
  vehiculoId          String
  estado              EstadoOT          @default(TURNO_AGENDADO)
  motivo              String?
  kmIngreso           Int?
  nivelCombustible    NivelCombustible?
  motivoCancelacion   String?
  // Id del borrador que la creó desde el módulo de carga por voz (taller-carga-voz).
  // Único: si llega dos veces el mismo borrador (reintento de red, doble tap), se
  // devuelve esta OT en vez de crear otra. Null en las OT creadas normalmente.
  origenBorradorVozId String?           @unique
  totalRepuestos      Decimal           @default(0) @db.Decimal(12, 2)
  totalManoObra       Decimal           @default(0) @db.Decimal(12, 2)
  total               Decimal           @default(0) @db.Decimal(12, 2)
  cerradaAt           DateTime?
  // Enlace secreto para compartir el informe de esta OT con el cliente (/informe/<token>).
  tokenInforme        String            @unique @default(dbgenerated("replace((gen_random_uuid())::text, '-'::text, ''::text)"))
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  cliente              Cliente               @relation(fields: [clienteId], references: [id])
  vehiculo             Vehiculo              @relation(fields: [vehiculoId], references: [id])
  turno                Turno?
  kilometrajes         KilometrajeRegistro[]
  timeline             TimelineEvento[]
  items                OTItem[]
  fotos                Foto[]
  presupuestos         Presupuesto[]
  movimientosStock     MovimientoStock[]
  cobros               Cobro[]
  solicitudFacturacion SolicitudFacturacion?

  @@index([clienteId])
  @@index([vehiculoId])
  @@index([estado])
}

// Inmutable: solo INSERT, nunca UPDATE ni DELETE.
model TimelineEvento {
  id     String   @id @default(cuid())
  otId   String
  estado EstadoOT
  nota   String?
  fecha  DateTime @default(now())
  // Quién generó el evento. Null en los eventos que ya existían y en los que
  // siguen saliendo del panel (ahí el usuario es implícito, la sesión del
  // local). Los endpoints de voz (api/voz/**) SIEMPRE lo completan, con el
  // valor del header X-Voz-Usuario, para auditoría.
  usuario String?
  // De dónde vino el evento: null = panel (comportamiento de siempre). "VOZ"
  // = creado por el asistente conversacional. No hay "estado" ni modelo
  // separado para una nota sin cambio de estado real: el modelo no lo
  // soporta (estado es NOT NULL) y agregarlo hoy rompería el resto del
  // panel que asume timeline == historial de estados. Para
  // POST /api/voz/ordenes/:id/notas (nota sin cambiar de estado) se
  // resuelve reusando el estado ACTUAL de la OT en el evento (no es un
  // cambio real, solo queda registrado con ese estado, igual que
  // publicarNovedadOT ya hace hoy en el panel) + origen="VOZ" para
  // distinguirlo de un cambio de estado real. La nota en sí queda prefijada
  // "[voz — <usuario>] " (ver src/lib/voz-timeline.ts) para que se vea el
  // origen en el panel sin tener que tocar su código de renderizado (fuera
  // del alcance de este agente: solo toca src/app/api/voz/**, src/lib/** y
  // prisma/migrations/**).
  origen String?

  ot OrdenTrabajo @relation(fields: [otId], references: [id])

  @@index([otId])
}

model OTItem {
  id             String     @id @default(cuid())
  otId           String
  tipo           TipoOTItem
  descripcion    String
  cantidad       Decimal    @db.Decimal(12, 2)
  precioUnitario Decimal    @db.Decimal(12, 2)
  // Opcional: si el repuesto viene del inventario, descuenta stock.
  repuestoId     String?
  // Trabajos: falla encontrada en el diagnóstico (descripcion = solución propuesta).
  falla          String?
  // Repuestos: si hay que pedirlo al proveedor y cómo.
  aPedir         Boolean    @default(false)
  // NO | A_PEDIR | PEDIDO | RECIBIDO (repuestos: se pide y después se recepciona al llegar).
  estadoPedido   String     @default("NO")
  notaPedido     String?
  createdAt      DateTime   @default(now())

  ot       OrdenTrabajo @relation(fields: [otId], references: [id])
  repuesto Repuesto?    @relation(fields: [repuestoId], references: [id])

  @@index([otId])
  @@index([repuestoId])
}

model Foto {
  id          String      @id @default(cuid())
  entidad     EntidadFoto
  otId        String?
  vehiculoId  String?
  gastoId     String?
  path        String
  fechaTomada DateTime    @default(now())
  tipo        String?

  ot       OrdenTrabajo? @relation(fields: [otId], references: [id])
  vehiculo Vehiculo?     @relation(fields: [vehiculoId], references: [id])
  gasto    Gasto?        @relation(fields: [gastoId], references: [id])

  @@index([otId])
  @@index([vehiculoId])
  @@index([gastoId])
}

model Presupuesto {
  id              String            @id @default(cuid())
  otId            String
  itemsSnapshot   Json
  total           Decimal           @db.Decimal(12, 2)
  validezDias     Int
  estado          EstadoPresupuesto @default(ENVIADO)
  enviadoAt       DateTime?
  respondidoAt    DateTime?
  metodoRespuesta String?
  createdAt       DateTime          @default(now())

  ot OrdenTrabajo @relation(fields: [otId], references: [id])

  @@index([otId])
}

model Config {
  clave String @id
  valor String
}

model Repuesto {
  id          String   @id @default(cuid())
  descripcion String
  codigo      String?
  proveedor   String?
  stock       Int      @default(0)
  stockMinimo Int      @default(0)
  costo       Decimal  @db.Decimal(12, 2)
  precioVenta Decimal  @db.Decimal(12, 2)
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  movimientos MovimientoStock[]
  otItems     OTItem[]

  @@index([descripcion])
}

// Inmutable: solo INSERT, nunca UPDATE ni DELETE.
model MovimientoStock {
  id         String              @id @default(cuid())
  repuestoId String
  tipo       TipoMovimientoStock
  cantidad   Int
  otId       String?
  fecha      DateTime            @default(now())

  repuesto Repuesto      @relation(fields: [repuestoId], references: [id])
  ot       OrdenTrabajo? @relation(fields: [otId], references: [id])

  @@index([repuestoId])
  @@index([otId])
}

model Gasto {
  id        String         @id @default(cuid())
  fecha     DateTime       @default(now())
  proveedor String
  categoria CategoriaGasto
  monto     Decimal        @db.Decimal(12, 2)
  notas     String?
  createdAt DateTime       @default(now())

  fotos Foto[]

  @@index([fecha])
  @@index([categoria])
}

model Cobro {
  id        String   @id @default(cuid())
  clienteId String
  otId      String?
  monto     Decimal  @db.Decimal(12, 2)
  fecha     DateTime @default(now())
  metodo    String?
  notas     String?
  // SENA (adelanto por el trabajo) o PAGO (pago parcial o final).
  concepto  String   @default("PAGO")

  cliente Cliente       @relation(fields: [clienteId], references: [id])
  ot      OrdenTrabajo? @relation(fields: [otId], references: [id])

  @@index([clienteId])
  @@index([otId])
}

// otId único: reintentar el envío no puede generar dos facturas del
// mismo trabajo. idExterno también único y determinístico (= numero OT).
model SolicitudFacturacion {
  id                String                     @id @default(cuid())
  otId              String                     @unique
  idExterno         String                     @unique
  clienteSnapshot   Json
  items             Json
  total             Decimal                    @db.Decimal(12, 2)
  fechaVenta        DateTime
  estado            EstadoSolicitudFacturacion @default(PENDIENTE)
  numeroComprobante String?
  cae               String?
  caeVencimiento    DateTime?
  pdfUrl            String?
  errorDetalle      String?
  enviadoAt         DateTime?
  facturadaAt       DateTime?
  createdAt         DateTime                   @default(now())

  ot OrdenTrabajo @relation(fields: [otId], references: [id])
}

// Idempotencia de los endpoints de escritura de voz (api/voz/**). Mismo
// concepto que OrdenTrabajo.origenBorradorVozId, generalizado a cualquier
// endpoint: se guarda la respuesta ya calculada bajo (endpoint,
// idempotencyKey); si el asistente reintenta con la misma key (red, doble
// confirmación) se devuelve la misma respuesta sin repetir el efecto. No
// tiene relación a OrdenTrabajo porque algunas respuestas guardadas son de
// error (p.ej. 404 "no existe esa OT") y no siempre hay una fila real detrás.
model VozIdempotencia {
  id             String   @id @default(cuid())
  endpoint       String
  idempotencyKey String
  respuesta      Json
  createdAt      DateTime @default(now())

  @@unique([endpoint, idempotencyKey])
}
